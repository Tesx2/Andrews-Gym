{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "andrews-gym",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "andrews-gym-db",
			"database_id": "e259c4c5-f31b-47e4-88cf-aef888880a42",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
    "BETTER_AUTH_URL": "https://andrews-gym.vincentmwangi478.workers.dev"
	}
}
